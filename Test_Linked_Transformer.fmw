FME_PYTHON_VERSION 312
ARCGIS_COMPATIBILITY ARCGIS_AUTO
#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
WRITER_TYPE MULTI_WRITER
WRITER_KEYWORD MULTI_DEST
MULTI_DEST_DATASET null
#! END_WB_HEADER
#! START_WB_HEADER
#! END_WB_HEADER
#! END_HEADER

LOG_FILENAME "$(FME_MF_DIR)$(WORKSPACE_NAME).log"
LOG_APPEND NO
LOG_TIMINGS YES
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2026.1.0.0 (20260311 - Build 26103 - WIN64)"
# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
MACRO DAF2_SchemaInfo_WORKSPACE_NAME DAF2_SchemaInfo
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_XFORMER_NAME DAF2_SchemaInfo
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_URLparameters 
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_DAF_Flexible_URL https://graphql.datafordeler.dk/flexible/v1/schema
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_apikey fme_decrypt()
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_Filter 
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_GetSchemaDataset BBR
MACRO $(DAF2_SchemaInfo_WORKSPACE_NAME)_GetSchemaForEntity Bygning
INCLUDE_CUSTOM_TRANSFORMER_VER DAF2_SchemaInfo:3
FACTORY_DEF * TeeFactory   FACTORY_NAME "DAF2_SchemaInfo Attributes Output Renamer/Nuker"   INPUT FEATURE_TYPE DAF2_SchemaInfo_Attributes
FACTORY_DEF * TeeFactory   FACTORY_NAME "DAF2_SchemaInfo AttributeInfo Output Renamer/Nuker"   INPUT FEATURE_TYPE DAF2_SchemaInfo_AttributeInfo   OUTPUT FEATURE_TYPE DAF2_SchemaInfo_AttributeInfo
FACTORY_DEF * TeeFactory   FACTORY_NAME "DAF2_SchemaInfo Relationships Output Renamer/Nuker"   INPUT FEATURE_TYPE DAF2_SchemaInfo_Relationships
FACTORY_DEF * TeeFactory   FACTORY_NAME "DAF2_SchemaInfo RelationshipInfo Output Renamer/Nuker"   INPUT FEATURE_TYPE DAF2_SchemaInfo_RelationshipInfo
FACTORY_DEF * TeeFactory   FACTORY_NAME "DAF2_SchemaInfo <Rejected> Output Renamer/Nuker"   INPUT FEATURE_TYPE DAF2_SchemaInfo_<Rejected>   OUTPUT FEATURE_TYPE DAF2_SchemaInfo_<Rejected>
FACTORY_DEF * BranchingFactory   FACTORY_NAME "DAF2_SchemaInfo_AttributeInfo Brancher -1 4"   INPUT FEATURE_TYPE DAF2_SchemaInfo_AttributeInfo   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME DAF2_SchemaInfo_<Rejected> INPUT FEATURE_TYPE DAF2_SchemaInfo_<Rejected>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, DAF2_SchemaInfo<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   INPUT FEATURE_TYPE *  OUTPUT FEATURE_TYPE *
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Logger_ace85c8d_3fce_41df_a20f_352946b99a9c5} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Logger
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Logger_Logger }    INPUT  FEATURE_TYPE DAF2_SchemaInfo_AttributeInfo    OUTPUT { FEATURE_TYPE Logger_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Registre<closeparen><space>-<space><at>Value<openparen>Entity<space>Name<closeparen><space>-<space><at>Value<openparen>Attribute<closeparen><space><openparen><at>Value<openparen>Data<space>type<closeparen><closeparen>,Logger)","<Unused>","100","",INFO,NONE,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Logger LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE Logger_LOGGED
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory FACTORY_NAME "Destination Feature Type Routing Correlator"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *   FEATURE_TYPE_ATTRIBUTE __wb_out_feat_type__   OUTPUT ROUTED FEATURE_TYPE *    OUTPUT NOT_ROUTED FEATURE_TYPE __nuke_me__ @Tcl2("FME_StatMessage 818059 [FME_GetAttribute fme_template_feature_type] 818060 818061 fme_warn")
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory   FACTORY_NAME "Final Output Nuker"   INPUT FEATURE_TYPE __nuke_me__

